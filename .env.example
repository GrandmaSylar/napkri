# Database connection string (Neon Serverless Postgres: https://neon.tech)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.c-5.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Cloudinary credentials for admin photo uploads & on-the-fly transformations (https://cloudinary.com)
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Admin dashboard security
# 1. Plaintext password required to log into the admin dashboard
ADMIN_PASSWORD=YourSecureAdminPassword123!

# 2. Secret key used to encrypt and sign admin session tokens (32+ random hex characters)
ADMIN_SESSION_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# 3. Secret URL slug where the admin lives (16 to 64 lowercase alphanumeric chars, no slashes)
# Direct access to /admin will 404; visit http://yourdomain/<ADMIN_PATH> instead.
ADMIN_PATH=nakpriadmin9821a
